# Database (required for persistent storage; omit to use in-memory store)
# PostgreSQL connection string. Examples:
# - Local: postgresql://user:password@localhost:5432/edi_portal
# - Neon:  postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# - Vercel Postgres: use the URL from Vercel Dashboard → Storage → Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/edi_portal"

# Frontend -> Python backend base URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Python backend auth settings (copy to backend/.env when running backend service)
AUTH_SECRET="replace-with-long-random-secret"
CORS_ORIGINS="http://localhost:3000"
EMAIL_MODE="mock"
LOCAL_STORAGE_PATH="./backend/storage"
SMTP_HOST="localhost"
SMTP_PORT="25"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS="false"
SMTP_FROM="no-reply@localhost"
INTEGRATION_API_KEYS="dev-integration-key"
LINKING_TIME_WINDOW_DAYS="7"
OAUTH_ACCESS_TOKEN_TTL_MINUTES="60"
OAUTH_ENABLE_API_KEY_FALLBACK="true"
OAUTH_ADMIN_KEY="dev-oauth-admin-key"
API_DAILY_QUOTA="20000"
API_MONTHLY_QUOTA="300000"
API_MAX_REQUEST_SIZE_BYTES="5242880"
API_IP_ALLOWLIST=""
PLATFORM_VERSION="1.0.0"
