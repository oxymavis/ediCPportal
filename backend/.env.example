APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edi_portal
AUTH_SECRET=replace-with-long-random-secret
COOKIE_NAME=edi_session
CSRF_COOKIE_NAME=edi_csrf
CSRF_HEADER_NAME=x-csrf-token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
EMAIL_MODE=mock
LOCAL_STORAGE_PATH=./storage
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=no-reply@localhost
INTEGRATION_API_KEYS=dev-integration-key
LINKING_TIME_WINDOW_DAYS=7
OAUTH_ACCESS_TOKEN_TTL_MINUTES=60
OAUTH_ENABLE_API_KEY_FALLBACK=true
OAUTH_ADMIN_KEY=dev-oauth-admin-key
API_DAILY_QUOTA=20000
API_MONTHLY_QUOTA=300000
API_MAX_REQUEST_SIZE_BYTES=5242880
API_IP_ALLOWLIST=
PLATFORM_VERSION=1.0.0
FEATURE_CONNECTION_TEST_REAL=true
FEATURE_API_DOCS_BACKEND=true
FEATURE_NOTIF_SSE=true
SANDBOX_API_TEST_ENDPOINT=https://httpbin.org/get
PRODUCTION_API_TEST_ENDPOINT=https://httpbin.org/get
