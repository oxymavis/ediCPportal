APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edi_portal
AUTH_SECRET=replace-with-long-random-secret
COOKIE_NAME=edi_session
CSRF_COOKIE_NAME=edi_csrf
CSRF_HEADER_NAME=x-csrf-token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
EMAIL_MODE=mock
LOCAL_STORAGE_PATH=./storage
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=no-reply@localhost
INTEGRATION_API_KEYS=dev-integration-key
LINKING_TIME_WINDOW_DAYS=7
OAUTH_ACCESS_TOKEN_TTL_MINUTES=60
OAUTH_ENABLE_API_KEY_FALLBACK=true
OAUTH_ADMIN_KEY=dev-oauth-admin-key
API_DAILY_QUOTA=20000
API_MONTHLY_QUOTA=300000
API_MAX_REQUEST_SIZE_BYTES=5242880
API_IP_ALLOWLIST=
PLATFORM_VERSION=1.0.0
FEATURE_CONNECTION_TEST_REAL=true
FEATURE_API_DOCS_BACKEND=true
FEATURE_NOTIF_SSE=true
API_TEST_ENDPOINT=https://httpbin.org/get
AS2_CONNECTIVITY_SANDBOX_URL=https://edi-staging.item.com:5555/invoke/UNIS_EDI_PORTAL.service:AS2_Connectivity_API
AS2_CONNECTIVITY_PRODUCTION_URL=https://edi-prod.item.com:443/invoke/UNIS_EDI_PORTAL.service:AS2_Connectivity_API
# 可选：覆盖所有环境的 AS2 Connectivity API 地址
AS2_CONNECTIVITY_URL=
# 方式 A：直接配置完整 Basic header，例如 Basic xxxxx
AS2_CONNECTIVITY_AUTHORIZATION=
# 方式 B：配置账号密码，由后端生成 Basic header
AS2_CONNECTIVITY_USERNAME=
AS2_CONNECTIVITY_PASSWORD=
AS2_CONNECTIVITY_TIMEOUT_SECONDS=30
AS2_CONNECTIVITY_VERIFY_TLS=true
# 必须改 backend/.env（根目录 .env 不会自动给后端用；见 app/core/config.py）
PARTNER_SYNC_ENABLED=false
# 方式 A：统一一套 URL/账号
PARTNER_SYNC_URL=
PARTNER_SYNC_USERNAME=
PARTNER_SYNC_PASSWORD=
# 方式 B：分环境（未设 PARTNER_SYNC_URL 时按 sandbox → production 回退）
PARTNER_SYNC_SANDBOX_URL=
PARTNER_SYNC_SANDBOX_USERNAME=
PARTNER_SYNC_SANDBOX_PASSWORD=
PARTNER_SYNC_PRODUCTION_URL=
PARTNER_SYNC_PRODUCTION_USERNAME=
PARTNER_SYNC_PRODUCTION_PASSWORD=
PARTNER_SYNC_TIMEOUT_SECONDS=10
PARTNER_SYNC_VERIFY_TLS=true
